# ============================================================================
# Environment Variables - Copy to .env and fill in values
# ============================================================================

# Application
ENVIRONMENT=development
DEBUG=true

# Database - MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=customer_intelligence

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production-abc123xyz
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ML Models
CHURN_THRESHOLD=0.5
NUM_CLUSTERS=4
CLV_PREDICTION_MONTHS=12
